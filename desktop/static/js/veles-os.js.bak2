cd ~/veles/veles/web/static/js/

# Sačuvaj staru verziju
cp veles-os.js veles-os.js.bak

# Napravi novi veles-os.js
cat > veles-os.js << 'EOF'
/*
 * =========================================================
 * VELES OS - COMPLETE (with built-in translation)
